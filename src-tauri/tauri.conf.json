{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slimora",
  "version": "2.0.1",
  "identifier": "com.kangedit-99.slimora-tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Slimora | Image Workspace",
        "width": 1240,
        "height": 760,
        "minWidth": 980,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDQUNCRUNCOUY2NDI0MTEKUldRUkpHU2Z5NzZzUERib290TkVsdFlaeTcvUC9xRFRTd3JQQ1JueDdiZUMrZmFwY0xhZkNxRnIK",
      "endpoints": [
        "https://github.com/tiyo1922/slimora-v2/releases/latest/download/latest.json"
      ]
    }
  }
}
